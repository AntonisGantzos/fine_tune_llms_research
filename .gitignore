/myvenv
/task for fine tuned models.txt
/data/*
/data/.gitkeep
.env

# Kaggle: ignore the copied data payload and downloaded outputs, but keep the
# tracked metadata (kaggle/kernel-metadata.json, kaggle/dataset_payload/dataset-metadata.json).
/kaggle/dataset_payload/CUAD_v1/
# NEVER commit the HF token — only its dataset-metadata.json is tracked.
/kaggle/dataset_payload_hf_token/hf_token.txt
# Staged LEDGAR CSVs (large; re-created by stage_data.ps1).
/kaggle/dataset_payload_ledgar/*.csv
/kaggle/dataset_payload_ledgar/labels.json
# Extension payloads: staged copies are re-created by push_extension_datasets.ps1;
# only each dataset-metadata.json is tracked.
/kaggle/dataset_payload_ext_*/*
!/kaggle/dataset_payload_ext_*/dataset-metadata.json
# Jupyter checkpoints and Kaggle CLI scratch/verification dirs (not source).
.ipynb_checkpoints/
__pycache__/
/_kchk/
/_dscheck/
/kaggle_output/
/kaggle_output_task1_fine_tuned
/kaggle_output_task1_baseline
/kaggle_output_task2_fine_tuned
/kaggle_output_task2_baseline
/kaggle_output_task3_fine_tuned
/kaggle_output_task3_baseline
# Legal-model extension: downloaded Kaggle runs, and local runner-notebook test artifacts.
/kaggle_output_extension/
/runs/
/pip_freeze.txt